# Mealio — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains private credentials.

# ── Supabase (required) ────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# ── Database direct connection (for backend/migrate.ts seed script only) ───────
# Find this in: Supabase Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# ── Supabase Service Role (optional — only needed for seed script) ─────────────
# Find this in: Supabase Dashboard → Settings → API → service_role (secret)
# WARNING: This key bypasses Row Level Security. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Resend (optional — for order confirmation emails via Edge Function) ─────────
# Sign up at https://resend.com — free tier is enough for a portfolio project
# Set in Supabase Dashboard → Edge Functions → Secrets (NOT in .env — server only)
# RESEND_API_KEY=re_your_resend_api_key

# ── Edge Function deployment ────────────────────────────────────────────────────
# To deploy the Edge Functions, run:
#   supabase login
#   supabase link --project-ref your-project-ref
#   supabase functions deploy validate-order
#   supabase functions deploy send-order-confirmation

# ── Sentry (optional — error monitoring) ───────────────────────────────────────
# Sign up at https://sentry.io — free tier available
# Find DSN in: Sentry Dashboard → Your Project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX

# ── Sentry Source Maps (CI/CD only — add as a GitHub Secret, NOT here) ─────────
# Generate at: Sentry Dashboard → Settings → Auth Tokens → Create New Token
# SENTRY_AUTH_TOKEN=sntrys_your_token_here
